# Copy to .env and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=
# Optional: defaults to the voice VU16byTywsWv5JpI8rbc. Override to swap voices.
ELEVENLABS_VOICE_ID=
# A long random string. The iOS app must send the same value as x-app-secret.
APP_SHARED_SECRET=change-me-to-a-long-random-string
PORT=8080
